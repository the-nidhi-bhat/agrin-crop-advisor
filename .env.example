# Copy this file to .env.local and fill in the values from your local Supabase stack.
# Never commit a real key. .gitignore already excludes .env.local and supabase/functions/.env.

# URL of the Supabase API gateway. With the local stack (npx supabase start) this is
# http://127.0.0.1:54321. For a hosted project use https://<project-ref>.supabase.co.
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase "anon" (publishable) key. It is safe to ship to browsers; Row Level Security
# still protects every row. Printed by `npx supabase status` (API keys / [1] anon key)
# or visible under Project Settings in the Supabase Studio dashboard on port 54323.
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Server-side only, never exposed to the browser:
# Google Gemini API key, read by the Edge Functions from supabase/functions/.env
# (a gitignored file at that path). Create one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key